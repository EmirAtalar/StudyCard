<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Studycard" android:textColor="#6ee7b7" android:textSize="14sp"/>
<TextView android:id="@+id/widget_term" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#f1f5f9" android:textSize="23sp" android:maxLines="2"/>
<TextView android:id="@+id/widget_meaning" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#94a3b8" android:textSize="16sp" android:maxLines="3"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:textColor="#6ee7b7" android:textSize="16sp"/>
<TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:textColor="#f1f5f9" android:textSize="16sp"/>
</LinearLayout></LinearLayout>
